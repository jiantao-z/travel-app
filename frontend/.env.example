# ============================================
# 智行规划师 — 前端环境变量配置
# ============================================
# 复制此文件为 .env 并填入你的真实配置值
# cp .env.example .env
# ============================================

# ── 后端 API 地址 ──
# 开发环境默认指向本地后端
VITE_API_BASE_URL=http://localhost:3001/api

# ── 高德地图 JS API Key（Web端）──
# 获取方式：https://lbs.amap.com/ 注册 → 应用管理 → 新建应用
# 选择「Web端(JS API)」类型，获取 Key 和安全密钥
VITE_AMAP_JS_KEY=your_amap_js_api_key_here

# ── 高德安全密钥（与 Web端 Key 配套，创建 Key 时下发）──
VITE_AMAP_SECURITY_CODE=your_amap_security_code_here

# ── 高德地图 Web 服务 API Key ──
# 与后端 AMAP_KEY 一致（用于前端直接调用逆地理编码等 Web 服务 API）
VITE_AMAP_WEB_KEY=your_amap_web_service_key_here
