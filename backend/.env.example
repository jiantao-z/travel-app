# ============================================
# 智行规划师 — 后端环境变量配置
# ============================================
# 复制此文件为 .env 并填入你的真实配置值
# cp .env.example .env
# ============================================

# 服务端口
PORT=3001

# ── PostgreSQL 数据库连接 ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traveldesigner
DB_USER=postgres
DB_PASS=your_db_password_here

# ── JWT 密钥（请使用随机字符串）──
JWT_SECRET=your_jwt_secret_here

# ── 高德地图 Web 服务 API Key ──
# 获取方式：https://lbs.amap.com/ 注册 → 应用管理 → 新建应用
# 选择「Web服务」类型，获取 Key
AMAP_KEY=your_amap_web_service_key_here

# ── DeepSeek AI API Key ──
# 获取方式：https://platform.deepseek.com/ 注册 → API Keys
# 用于 AI 智能旅游规划功能
DEEPSEEK_API_KEY=your_deepseek_api_key_here
